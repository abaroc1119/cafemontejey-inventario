# Servidor
PORT=4000
NODE_ENV=production
# Pon 1 si el API corre detrás de un proxy (Render, Railway, Nginx...)
TRUST_PROXY=1

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_DATABASE=

# JWT: mínimo 32 caracteres aleatorios (genera uno con: openssl rand -base64 48)
JWT_SECRET=

# Frontend (Vercel). FRONTEND_URL se usa en el enlace de recuperación de contraseña.
FRONTEND_URL=https://tu-dominio-de-produccion
# Orígenes permitidos por CORS, separados por coma (producción y QA)
CORS_ORIGINS=https://tu-dominio-de-produccion,https://cafemontejey-inventario-qa.vercel.app

# Correo (recuperación de contraseña)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Café Montejey - Inventario" <no-reply@cafemontejey.com>
